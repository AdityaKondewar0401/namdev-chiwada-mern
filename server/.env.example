# server/.env.example
#
# Copy this file to server/.env and fill in real values.
# server/.env itself must NEVER be committed — it's already in .gitignore.
# This .example file is safe to commit: no real secrets, just the shape.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Atlas dashboard → Database → Connect →
# Drivers). Includes a username/password — treat it as a secret.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-url>/<db-name>?retryWrites=true&w=majority

# Long random string used to sign JWTs — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=30d

# ── Google OAuth ──────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
# Not secret by itself (it's also exposed client-side as VITE_GOOGLE_CLIENT_ID)
# but keep it here too since the backend verifies tokens against it.
GOOGLE_CLIENT_ID=

# ── Cloudinary (product image hosting) ────────────────
# Cloudinary dashboard → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Razorpay (payments) ────────────────────────────────
# Razorpay dashboard → Settings → API Keys. key_id is also used client-side
# (VITE_RAZORPAY_KEY_ID) and is not sensitive; key_secret is sensitive and
# server-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Transactional email ────────────────────────────────
# If using Gmail: an App Password, not your real Gmail password
# (Google Account → Security → 2-Step Verification → App passwords).
EMAIL_USER=
EMAIL_PASS=

# Brevo (Sendinblue) API key, if used instead of/alongside EMAIL_*.
BREVO_API_KEY=

# ── Rate limiting (all optional — sane defaults in config/rateLimits.js) ──
# Tier 1: strict, per-IP, auth routes (register/login/google)
RATE_LIMIT_IP_AUTH_WINDOW_MS=900000
RATE_LIMIT_IP_AUTH_MAX=20
# Tier 2: moderate, per-IP, public read endpoints
RATE_LIMIT_IP_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_IP_PUBLIC_MAX=100
# Tier 3: loose, per-user, authenticated actions
RATE_LIMIT_IP_USER_WINDOW_MS=60000
RATE_LIMIT_IP_USER_MAX=180
# Shadowfax webhook (server-to-server, separate from browser traffic)
RATE_LIMIT_IP_WEBHOOK_WINDOW_MS=60000
RATE_LIMIT_IP_WEBHOOK_MAX=120
# Per-account exponential backoff (stacks on top of Tier 1 above)
RATE_LIMIT_LOGIN_FREE_ATTEMPTS=5
RATE_LIMIT_LOGIN_BASE_DELAY_MS=2000
RATE_LIMIT_LOGIN_MAX_DELAY_MS=900000
RATE_LIMIT_REGISTER_FREE_ATTEMPTS=5
RATE_LIMIT_REGISTER_BASE_DELAY_MS=5000
RATE_LIMIT_REGISTER_MAX_DELAY_MS=1800000
RATE_LIMIT_PW_RESET_FREE_ATTEMPTS=3
RATE_LIMIT_PW_RESET_BASE_DELAY_MS=5000
RATE_LIMIT_PW_RESET_MAX_DELAY_MS=1800000
# How long a quiet account-limit record survives before Mongo TTL-reaps it
RATE_LIMIT_RECORD_TTL_SECONDS=86400
# How many reverse-proxy hops to trust for the real client IP (Railway = 1)
TRUST_PROXY_HOPS=1

# ── Shadowfax Courier (Forward Operations — Warehouse Order Creation) ──
# "staging" or "production". Switch to "production" and swap the token
# below when you go live — nothing else in the code needs to change.
SHADOWFAX_ENV=staging
SHADOWFAX_AUTH_TOKEN=

# Shared secret you also configure in the Shadowfax Client Portal's
# Webhook tab, so /api/shipping/webhook/shadowfax can verify a push
# callback really came from Shadowfax. Leave blank in staging if
# Shadowfax's staging webhook sender doesn't support custom headers yet.
SHADOWFAX_WEBHOOK_TOKEN=

# Pickup / warehouse details — same address used for RTO since this
# business does not use a returns flow.
SHADOWFAX_PICKUP_CONTACT_NAME=
SHADOWFAX_PICKUP_CONTACT_PHONE=
SHADOWFAX_PICKUP_ADDRESS_LINE1=
SHADOWFAX_PICKUP_ADDRESS_LINE2=
SHADOWFAX_PICKUP_CITY=
SHADOWFAX_PICKUP_STATE=
SHADOWFAX_PICKUP_PINCODE=
SHADOWFAX_PICKUP_UNIQUE_CODE=

# GSTIN — optional; only required by Shadowfax if a single order's
# product value exceeds ₹50,000 (not expected for this catalog).
SHADOWFAX_GSTIN=

# Business rule: a single order/package must not exceed 7kg.
SHADOWFAX_MAX_ORDER_WEIGHT_GRAMS=7000
SHADOWFAX_DEFAULT_ITEM_WEIGHT_GRAMS=250

# Your deployed frontend origin — must match exactly for CORS to allow it.
# e.g. https://namdevchiwada.com or https://your-project.vercel.app
CLIENT_URL=
