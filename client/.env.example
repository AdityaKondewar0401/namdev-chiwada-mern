# client/.env.example
#
# Copy this file to client/.env and fill in real values.
#
# IMPORTANT: Vite bundles every VITE_-prefixed variable directly into the
# JavaScript shipped to the browser — anyone can read these from browser
# devtools. Only put values here that are SAFE to be public:
#   - VITE_RAZORPAY_KEY_ID is Razorpay's publishable key_id (safe by design;
#     the sensitive one, key_secret, must only ever live in server/.env)
#   - VITE_GOOGLE_CLIENT_ID is a public OAuth client identifier (safe by
#     design — Google's own docs confirm this is not a secret)
# Never add a *_SECRET, *_KEY_SECRET, *_TOKEN, *_PASSWORD, or similar
# server-only credential here, even temporarily for testing.

# Your backend API's base URL (e.g. https://api.yourdomain.com, or your
# Railway URL, or http://localhost:5000 for local dev)
VITE_API_URL=

VITE_GOOGLE_CLIENT_ID=

VITE_RAZORPAY_KEY_ID=

# WhatsApp ordering bot's number (digits only, e.g. 15551234567 — Meta's
# free TEST number during Phase 0, then the real business number after
# cutover). Powers the "Order on WhatsApp" button on product pages. Safe
# to be public — it's just a phone number, same as WhatsAppFloat's.
# Leave blank to hide that button entirely (e.g. before Phase 0 is done).
VITE_WHATSAPP_BOT_NUMBER=

